<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/item_feed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imagePost"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:contentDescription="Post Image"
            android:scaleType="centerCrop"
            android:src="@drawable/contoh_feed"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/ll_btns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="5dp"
            android:orientation="horizontal"
            android:padding="8dp"
            app:layout_constraintTop_toBottomOf="@id/imagePost">

            <ImageButton
                android:id="@+id/btn_like"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@color/fui_transparent"
                android:contentDescription="Like"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_like_line" />

            <ImageButton
                android:id="@+id/btn_comment"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="10dp"
                android:background="@color/fui_transparent"
                android:contentDescription="Comment"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_comment_line"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btn_share"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="10dp"
                android:background="@color/fui_transparent"
                android:contentDescription="Share"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_share_line" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_username_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:fontFamily="@font/pjs_regular"
            android:lineSpacingExtra="2dp"
            android:paddingHorizontal="8dp"
            android:text="octagondragon Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nullam nec semper sapien. Mauris commodo diam vitae neque elementum, quis dictum nunc ultricies"
            android:textColor="#000000"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/ll_btns" />

        <TextView
            android:id="@+id/tv_created_at"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_marginVertical="5dp"
            android:padding="8dp"
            android:text="Jan 29"
            android:textColor="#888888"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_username_caption"
            app:layout_constraintVertical_bias="1" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>

