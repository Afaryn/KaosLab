<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:orientation="vertical"
    tools:context=".presentation.ui_customer.cart.checkout.CheckOutActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/background"
            android:elevation="8dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:theme="@style/ThemeOverlay.AppCompat.ActionBar"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/background"
                android:src="@drawable/ic_left_line" />

            <TextView
                android:id="@+id/title_toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:fontFamily="@font/pjs_bold"
                android:gravity="center"
                android:text="Checkout"
                android:textColor="@color/darkBlue"
                android:textSize="20sp"
                android:textStyle="bold" />
        </androidx.appcompat.widget.Toolbar>

        <TextView
            android:id="@+id/tv_address_holder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/pjs_bold"
            android:text="Shipping Address"
            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/text_md"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar" />

        <ImageView
            android:id="@+id/ic_pin"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/ic_pin"
            app:layout_constraintStart_toStartOf="@id/tv_address_holder"
            app:layout_constraintTop_toBottomOf="@id/tv_address_holder" />

        <TextView
            android:id="@+id/tv_address_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:ellipsize="end"
            android:fontFamily="@font/pjs_medium"
            android:maxLines="1"
            android:text="Pick an Address"
            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/text_sm"
            app:layout_constraintBottom_toBottomOf="@id/ic_pin"
            app:layout_constraintEnd_toStartOf="@id/btn_change_address"
            app:layout_constraintStart_toEndOf="@id/ic_pin"
            app:layout_constraintTop_toTopOf="@id/ic_pin" />

        <TextView
            android:id="@+id/tv_address_detail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="10dp"
            android:ellipsize="end"
            android:fontFamily="@font/plusjakartasans"
            android:maxLines="3"
            android:text="-"
            android:textColor="@color/dimgray"
            android:textSize="@dimen/text_sm"
            app:layout_constraintEnd_toStartOf="@id/btn_change_address"
            app:layout_constraintStart_toEndOf="@id/ic_pin"
            app:layout_constraintTop_toBottomOf="@id/tv_address_name" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_change_address"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="20dp"
            android:insetLeft="10dp"
            android:insetTop="5dp"
            android:insetRight="10dp"
            android:insetBottom="5dp"
            android:padding="0dp"
            android:text="Change"
            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/text_xxs"
            app:backgroundTint="@color/background"
            app:layout_constraintBottom_toBottomOf="@id/tv_address_detail"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_address_name"
            app:strokeColor="@color/textLine"
            app:strokeWidth="1dp" />

        <View
            android:id="@+id/view_divider_1"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="20dp"
            android:alpha="0.5"
            android:background="@color/textLine"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_address_detail" />

        <TextView
            android:id="@+id/tv_order_summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/pjs_bold"
            android:text="Order Summary"
            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/text_md"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/view_divider_1" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_products"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="20dp"
            app:layout_constraintBottom_toTopOf="@id/tv_total_holder"
            app:layout_constraintTop_toBottomOf="@id/tv_order_summary"
            tools:listitem="@layout/item_cart_co" />

        <TextView
            android:id="@+id/tv_total_holder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:fontFamily="@font/pjs_regular"
            android:text="Total"
            android:textSize="@dimen/text_sm"
            app:layout_constraintBottom_toTopOf="@id/tv_service_fee_holder"
            app:layout_constraintStart_toStartOf="@id/tv_service_fee_holder" />

        <TextView
            android:id="@+id/tv_total"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="10dp"
            android:fontFamily="@font/pjs_regular"
            android:text="Rp. 0,-"
            android:textSize="@dimen/text_sm"
            app:layout_constraintBottom_toTopOf="@id/tv_service_fee"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tv_service_fee_holder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginVertical="10dp"
            android:fontFamily="@font/pjs_regular"
            android:text="Service Fee"
            android:textSize="@dimen/text_sm"
            app:layout_constraintBottom_toTopOf="@id/tv_sub_total_holder"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tv_service_fee"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pjs_regular"
            android:text="Rp. 7.000.00,-"
            android:textSize="@dimen/text_sm"
            app:layout_constraintEnd_toEndOf="@id/tv_total"
            app:layout_constraintTop_toTopOf="@id/tv_service_fee_holder" />

        <TextView
            android:id="@+id/tv_sub_total_holder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp"
            android:fontFamily="@font/pjs_bold"
            android:text="Sub Total"
            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/text_md"
            app:layout_constraintBottom_toTopOf="@id/view_divider_2"
            app:layout_constraintStart_toStartOf="@id/tv_service_fee_holder" />

        <TextView
            android:id="@+id/tv_sub_total"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pjs_bold"
            android:text="Rp. 0,-"
            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/text_md"
            app:layout_constraintBottom_toBottomOf="@id/tv_sub_total_holder"
            app:layout_constraintEnd_toEndOf="@id/tv_service_fee" />

        <View
            android:id="@+id/view_divider_2"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginBottom="20dp"
            android:background="@color/background"
            android:elevation="1dp"
            app:layout_constraintBottom_toTopOf="@id/tv_sub_total_holder_2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tv_sub_total_holder_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="40dp"
            android:layout_marginVertical="3dp"
            android:fontFamily="@font/pjs_bold"
            android:text="Sub Total"
            android:textColor="@color/dimgray"
            android:textSize="@dimen/text_md"
            app:layout_constraintBottom_toTopOf="@id/tv_sub_total_2"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tv_sub_total_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="40dp"
            android:layout_marginVertical="20dp"
            android:fontFamily="@font/pjs_bold"
            android:text="Rp. 0,-"
            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/text_lg"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_payment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="40dp"
            android:fontFamily="@font/pjs_bold"
            android:text="Payment"
            app:backgroundTint="@color/colorPrimary"
            app:cornerRadius="10dp"
            app:layout_constraintBottom_toBottomOf="@id/tv_sub_total_2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_sub_total_holder_2" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
