<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/admin_home_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginTop="20dp"
    app:cardBackgroundColor="@color/background"
    app:cardCornerRadius="10dp"
    app:layout_constraintTop_toBottomOf="@id/btn_back">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="120dp"
        android:padding="10dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ic_bookmark"
            style="@style/Widget.Material3.MaterialTimePicker.ImageButton"
            android:layout_width="30dp"
            android:layout_height="30dp"
            app:icon="@drawable/ic_pin"
            app:iconSize="20dp"
            app:backgroundTint="@color/textLine"
            app:iconTint="@color/colorPrimary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/btn_options"
            android:layout_width="18dp"
            android:layout_height="18dp"
            app:backgroundTint="@android:color/transparent"
            android:src="@drawable/ic_three_dot"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_address_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/pjs_bold"
            android:textSize="@dimen/text_md"
            app:layout_constraintBottom_toBottomOf="@id/ic_bookmark"
            app:layout_constraintStart_toEndOf="@id/ic_bookmark"
            app:layout_constraintTop_toTopOf="@id/ic_bookmark"
            tools:text="Kantor" />

        <TextView
            android:id="@+id/tv_address"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:fontFamily="@font/pjs_medium"
            android:text="xxxxxxx"
            android:textSize="@dimen/text_md"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ic_bookmark" />

        <TextView
            android:id="@+id/tv_address_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_address"
            android:layout_alignStart="@id/tv_address"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="10dp"
            android:fontFamily="@font/pjs_regular"
            android:text="Pagar putih"
            android:textSize="@dimen/text_sm"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tv_address"
            app:layout_constraintTop_toBottomOf="@id/tv_address" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>