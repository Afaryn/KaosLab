<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeDesignerFragment">

    <fragment
        android:id="@+id/homeDesignerFragment"
        android:name="com.afaryn.kaoslab.ui_designer.home.HomeDesignerFragment"
        android:label="fragment_home_designer"
        tools:layout="@layout/fragment_home_designer" />

    <fragment
        android:id="@+id/accountDesignerFragment"
        android:name="com.afaryn.kaoslab.ui_designer.account.AccountDesignerFragment"
        android:label="fragment_account_designer"
        tools:layout="@layout/fragment_account_designer">

        <action
            android:id="@+id/action_accountDesignerFragment_to_sellerCentreFragment"
            app:destination="@id/sellerCentreFragment" />
    </fragment>

    <fragment
        android:id="@+id/feedDesignerFragment"
        android:name="com.afaryn.kaoslab.ui_designer.feed.FeedDesignerFragment"
        android:label="fragment_feed_designer"
        tools:layout="@layout/fragment_feed_designer" />

<!--    <fragment-->
<!--        android:id="@+id/customFragment"-->
<!--        android:name="com.afaryn.kaoslab.ui_designer.custom.CustomFragment"-->
<!--        android:label="fragment_custom"-->
<!--        tools:layout="@layout/fragment_custom" />-->

    <!-- Seller Centre Navigation -->
    <fragment
        android:id="@+id/sellerCentreFragment"
        android:name="com.afaryn.kaoslab.ui_designer.seller_centre.SellerCentreFragment"
        android:label="fragment_seller_centre"
        tools:layout="@layout/fragment_seller_centre">

        <action
            android:id="@+id/action_sellerCentreFragment_to_designListFragment"
            app:destination="@id/designListFragment" />
    </fragment>

    <!-- Design Management Navigation -->
    <fragment
        android:id="@+id/designListFragment"
        android:name="com.afaryn.kaoslab.ui_designer.manage_design.DesignListFragment"
        android:label="fragment_design_list"
        tools:layout="@layout/fragment_design_list">

        <action
            android:id="@+id/action_designListFragment_to_addDesignFragment"
            app:destination="@id/addDesignFragment" />

        <action
            android:id="@+id/action_designListFragment_to_detailEditDesignFragment"
            app:destination="@id/detailEditDesignFragment" />
    </fragment>

    <fragment
        android:id="@+id/addDesignFragment"
        android:name="com.afaryn.kaoslab.ui_designer.manage_design.AddDesignFragment"
        android:label="fragment_add_design"
        tools:layout="@layout/fragment_add_design" />

    <fragment
        android:id="@+id/detailEditDesignFragment"
        android:name="com.afaryn.kaoslab.ui_designer.manage_design.DetailEditDesignFragment"
        android:label="fragment_detail_edit_design"
        tools:layout="@layout/fragment_detail_edit_design">

        <argument
            android:name="designId"
            app:argType="string" />
    </fragment>

</navigation>
